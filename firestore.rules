rules_version = '2';

// Tether — directory + DM rules.
//
// Tether runs on the Spark (free) plan by design: no Cloud Functions, no native
// TTL policy, no Cloud Storage. Everything these rules protect is written
// directly by clients, so the rules are the only enforcement point. They are
// written to assume the client is hostile.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // The two UIDs encoded in a thread id.
    function members(pairId) {
      return pairId.split('_');
    }

    function isParticipant(pairId) {
      return signedIn() && me() in members(pairId);
    }

    // Must match SWEEP_MIN_AGE_DAYS in shared/schema.js.
    function sweepFloor() {
      return duration.value(30, 'd');
    }

    // Profile pictures and server icons are base64 in the document itself
    // rather than Cloud Storage. Firestore's hard limit is 1MiB per document,
    // so cap the encoded string well below it and leave room for other fields.
    function withinImageBudget(field) {
      return !(field in request.resource.data.keys())
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 400000);
    }

    // --- Username index -----------------------------------------------------
    // usernames/{username} -> { uid }. Purely a uniqueness + lookup index.
    //
    // Uniqueness is enforced structurally: the username *is* the document id,
    // and create is only permitted when no document exists at that id. Firestore
    // evaluates create against a non-existent resource, so a second claim of the
    // same handle is rejected by the engine, not by a check we could race.
    match /usernames/{username} {

      // Anyone signed in can resolve a handle to a UID — that is the point.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid'])
        && username.matches('^[a-z0-9_]{3,20}$');

      // Handles are immutable once claimed. Allowing update would let someone
      // repoint an existing handle at a different account; allowing delete
      // would let them free it and let an impersonator re-claim it.
      allow update, delete: if false;
    }

    // --- Profiles -----------------------------------------------------------
    match /users/{uid} {

      allow read: if signedIn();

      // Note: `username` here is a denormalized display copy and is NOT verified
      // against the index. It cannot be: the profile and the username claim are
      // written in one atomic batch, and rules `get()` cannot see a document
      // created in the same commit — verified against the emulator.
      //
      // usernames/{username} -> uid stays authoritative, and it is the only
      // direction that matters: peers are always resolved handle -> uid through
      // the index, never by trusting a profile's self-reported handle.
      allow create, update: if signedIn()
        && me() == uid
        && withinImageBudget('pfpBase64');

      allow delete: if signedIn() && me() == uid;

      // Which conversations this user has. Pointers only — never content.
      // This is what lets the client re-open every thread on launch and hold a
      // listener on each, instead of only the ones opened by hand this session.
      match /dms/{peerUid} {
        allow read, write: if signedIn() && me() == uid;
      }

      // Which servers this user has joined, and the client config needed to
      // reach each one. Pointers only — a server's content lives in that
      // server's own Firebase project, never here.
      match /servers/{serverId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // --- DM threads ---------------------------------------------------------
    match /dms/{pairId} {

      allow read: if isParticipant(pairId);
      allow write: if false;

      match /messages/{messageId} {

        allow read: if isParticipant(pairId);

        // A sender may only write as themselves, may not backdate, and may not
        // list themselves as pending — they already have the message.
        allow create: if isParticipant(pairId)
          && request.resource.data.senderUid == me()
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 4000
          && request.resource.data.sentAt == request.time
          && request.resource.data.pendingFor is list
          && request.resource.data.pendingFor.hasOnly(members(pairId))
          && !(me() in request.resource.data.pendingFor);

        // The only legal edit is acking: removing yourself from pendingFor.
        allow update: if isParticipant(pairId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingFor'])
          && !(me() in request.resource.data.pendingFor)
          && request.resource.data.pendingFor.hasOnly(resource.data.pendingFor);

        // Three ways a message may be deleted, and no others:
        //
        //  1. Its own sender removes it — an unsend. If the recipient has not
        //     collected it yet, they never will.
        //  2. Delivered — nobody is waiting on it any more.
        //  3. Abandoned — someone never collected it, and it is older than the
        //     sweep floor. This is what replaces a native TTL policy on Spark.
        //
        // The age floor still applies to cases 2 and 3, which is what stops the
        // sweep from becoming an unsend button for the *other* participant:
        // nobody but the sender may delete a message the recipient has not
        // picked up yet.
        allow delete: if isParticipant(pairId)
          && (
            resource.data.senderUid == me()
            || resource.data.pendingFor.size() == 0
            || resource.data.sentAt < request.time - sweepFloor()
          );
      }

      // A sender's later edit or deletion of a message they sent.
      //
      // These exist because a delivered message is already gone from the server
      // — copied to local history, acked, and cleaned up — so there is nothing
      // left to mutate. A revision travels like any other message and is applied
      // to each recipient's own copy.
      //
      // Rules cannot check that the reviser sent the original, since the
      // original may no longer exist. They enforce only that a reviser cannot
      // claim to be somebody else; recipients hold the original and refuse
      // revisions whose sender does not match it.
      match /revisions/{revisionId} {

        allow read: if isParticipant(pairId);

        allow create: if isParticipant(pairId)
          && request.resource.data.senderUid == me()
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && (request.resource.data.type == 'edit' || request.resource.data.type == 'delete')
          && (
            request.resource.data.type == 'delete'
              ? request.resource.data.content == null
              : (request.resource.data.content is string
                 && request.resource.data.content.size() > 0
                 && request.resource.data.content.size() <= 4000)
          )
          && request.resource.data.sentAt == request.time
          && request.resource.data.pendingFor is list
          && request.resource.data.pendingFor.hasOnly(members(pairId))
          && !(me() in request.resource.data.pendingFor);

        // Acking, exactly as for messages.
        allow update: if isParticipant(pairId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingFor'])
          && !(me() in request.resource.data.pendingFor)
          && request.resource.data.pendingFor.hasOnly(resource.data.pendingFor);

        allow delete: if isParticipant(pairId)
          && (
            resource.data.pendingFor.size() == 0
            || resource.data.sentAt < request.time - sweepFloor()
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
